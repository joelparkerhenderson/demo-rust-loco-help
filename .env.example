##
# Environment
#
# To export all these:
#
#     export $(grep ^\\w .env | xargs -0)
##

##
# Database
#
# Example to connect:
#
#     psql --host="$DB_HOST" --port="$DB_PORT" --username="$DB_OWNER_USERNAME" --password "$DB_NAME"
##

DB_STEM=demo_rust_loco
DB_NAME=demo_rust_loco_development
DB_HOST=localhost
DB_PORT=5432
DB_OWNER_USERNAME=demo_rust_loco_owner
DB_OWNER_PASSWORD=6c205ea7be275e827d1c1add3a235bef
DB_URL=postgres://demo_rust_loco_owner:6c205ea7be275e827d1c1add3a235bef@localhost:5432/demo_rust_loco_development

##
# Mailer
#
# Fastmail settings if you want to do manual command line examples:
#
#    MAILER_USERNAME_BASE64 = echo -n "$MAILER_USERNAME" | openssl enc -base64
#    MAILER_PASSWORD_BASE64 = echo -n "$MAILER_PASSWORD" | openssl enc -base64
#
# Curl settings if you want to do manual command line examples:
#
#     curl \
#         --location '127.0.0.1:5150/api/auth/register' \
#         --header 'Content-Type: application/json'
#         --data-raw '{
#             "name": "Alice",
#             "email": "alice@example.com",
#             "password": "secret"
#         }'
#
##

MAILER_HOST=smtp.fastmail.com
